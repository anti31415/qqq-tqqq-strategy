# Alpaca paper credentials
ALPACA_API_KEY_ID=your_paper_key_id
ALPACA_API_SECRET_KEY=your_paper_secret_key
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# IBKR Client Portal Gateway
IBKR_GATEWAY_BASE_URL=https://localhost:5000/v1/api

# Strategy defaults
STRATEGY_UNDERLYING_SIGNAL=QQQ
STRATEGY_UNDERLYING_TRADE=TQQQ
STRATEGY_DTE_TARGET=33
STRATEGY_PUT_STRIKE_PCT=0.92
STRATEGY_RSI_THRESHOLD=50
STRATEGY_SMA_PERIOD=200
MARKET_TIMEZONE=America/New_York

# Local email notification (only used after a paper order is actually submitted)
NOTIFY_EMAIL_TO=your_destination_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your_sender_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_sender_email@gmail.com

# Safety
DRY_RUN=true
